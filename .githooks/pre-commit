#!/bin/sh
# pre-commit: 提交时前后端静态检查。
#   后端: goimports（未安装则用 gofmt）+ go vet
#   前端: eslint --fix（自动修复，修改会重新暂存）
#
# 未安装 goimports 时回退 gofmt；golangci-lint 不在本钩子范围（见 pre-push）。
# 安装: go install golang.org/x/tools/cmd/goimports@latest
#
# 启用本钩子（仓库本地，克隆后需重新执行）:
#   git config core.hooksPath .githooks

set -e

GO_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
FE_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')

# --- 后端: goimports/gofmt（自动修复）+ go vet ---
if [ -n "$GO_FILES" ]; then
  if command -v goimports >/dev/null 2>&1; then
    FMT=goimports
  else
    FMT=gofmt
    echo "pre-commit: goimports 未安装，用 gofmt"
  fi
  # 能自动修复的直接 -w 修复（goimports 还会整理 import 分组），再校验是否还有剩余。
  $FMT -w $GO_FILES
  out=$($FMT -l $GO_FILES)
  if [ -n "$out" ]; then
    echo "pre-commit: 以下 Go 文件仍有格式问题（$FMT -w 无法修复）:"
    echo "$out"
    exit 1
  fi
  git add $GO_FILES
  echo "==> go vet"
  go vet ./cmd/... ./internal/...
fi

# --- 前端: eslint --fix（自动修复并重新暂存） ---
if [ -n "$FE_FILES" ]; then
  echo "==> eslint --fix"
  # eslint 在 web/ 目录内运行，路径需去掉仓库根的 web/ 前缀。
  REL_FILES=$(echo "$FE_FILES" | sed 's#^web/##')
  (cd web && pnpm exec eslint --fix $REL_FILES)
  git add $FE_FILES
fi

exit 0
