#!/bin/sh
# pre-commit: 提交时前后端静态检查。
#   后端: golangci-lint --fix（自动修复，修改会重新暂存）
#         配置见 .golangci.yml：已含 goimports / go vet（standard 组），
#         故不再单独跑 goimports / go vet。
#   前端: eslint --fix（自动修复，修改会重新暂存）
#
# golangci-lint 未安装时跳过并提示（不阻塞提交）。
# 安装: go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
#
# 启用本钩子（仓库本地，克隆后需重新执行）:
#   git config core.hooksPath .githooks

set -e

GO_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
FE_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')

# --- 后端: golangci-lint（自动修复并重新暂存） ---
if [ -n "$GO_FILES" ]; then
  if command -v golangci-lint >/dev/null 2>&1; then
    echo "==> golangci-lint --fix"
    golangci-lint run --fix
    git add $GO_FILES
  else
    echo "pre-commit: golangci-lint 未安装，跳过"
  fi
fi

# --- 前端: eslint --fix（自动修复并重新暂存） ---
if [ -n "$FE_FILES" ]; then
  echo "==> eslint --fix"
  # eslint 在 web/ 目录内运行，路径需去掉仓库根的 web/ 前缀。
  REL_FILES=$(echo "$FE_FILES" | sed 's#^web/##')
  (cd web && pnpm exec eslint --fix $REL_FILES)
  git add $FE_FILES
fi

exit 0
