# EasyServer Configuration
# Copy this file to config.toml and modify as needed

[server]
port = 8080
host = "0.0.0.0"
dev_mode = false       # 开发模式，允许 localhost Origin（生产环境设为 false）
allowed_origins = [
  "http://localhost:5173",
  # "https://yourdomain.com",
]
force_domain = false   # 开启后非匹配主机名访问将 301 重定向至 domain
domain = ""            # 面板对外域名（可选）
assets_rate_limit = 5000    # 静态资源限流：每窗口最大请求数
assets_rate_interval = "1m" # 静态资源限流窗口
max_upload_size = 536870912 # 最大上传字节，0 = 默认 512MB
trusted_proxies = ["127.0.0.1"] # 反向代理可信 CIDR（X-Forwarded-For 信任范围）

[server.tls]
enabled = false
cert_file = ""
key_file = ""

[server.turnstile]
site_key = ""
secret_key = ""
enable_login = false
enable_qr_login = false
enable_public_share = false

[auth]
# jwt_secret: 留空时系统将在首次启动时自动生成高强度随机密钥并持久化保存
# 也可通过环境变量 EASYSERVER_JWT_SECRET 指定
# jwt_secret = ""
session_timeout = "24h"
idle_timeout = "30m"
max_login_attempts = 5
lockout_duration = "15m"
rate_limit = 1000      # Max requests per interval
rate_interval = "1m"   # Rate limit interval
login_rate_limit = 60  # Login & QR polling rate limit per interval
login_rate_interval = "1m"
ip_whitelist = []      # Empty = allow all; e.g., ["192.168.1.0/24", "10.0.0.1"]
session_cleanup_interval = "5m" # 过期会话清理间隔
allow_multi_session = false # 允许多端同时登录

[monitor]
history_retention = "168h"
collect_interval = "3s"

[audit]
retention_days = 90

[filemanager]
base_path = "/opt/easyserver/data" # 文件管理器根目录；留空 = 整个文件系统（/）

[notify]
enabled = false
webhook_url = "" # 钉钉/飞书/企微 Webhook URL

[logs]
level = "info"        # 日志等级: debug|info|warn|error（可在面板设置中运行时修改并持久化）
# path = ""          # 日志文件路径；留空 = 应用根目录 easyserver.log（由 DataRoot 派生）
format = "text"       # 输出格式: text|json
max_size_mb = 10      # 单文件轮转阈值 (MB)
max_files = 3         # 保留轮转文件数 (.1 .2 …)

[alerts]
rules = []
