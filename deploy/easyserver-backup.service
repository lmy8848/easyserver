[Unit]
Description=EasyServer panel automatic backup (config + SQLite snapshot)
Documentation=https://github.com/lmy8848/easyserver
After=easyserver.service
Wants=easyserver.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/easyserver
# 走 CLI 而不是 HTTP：不需要登录会话，也不依赖面板是否健康。
ExecStart=/usr/local/bin/easyserver -config /opt/easyserver/config.toml backup -out /opt/easyserver/backups -keep-days 14
# 备份含密钥与数据库，权限只给 root。
UMask=0077
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
